# =============================================================================
# M.A.R.I.A. - Environment configuration
# =============================================================================
# Copy this file to .env and edit the values:
#   cp .env.example .env
#   nano .env
#
# NEVER commit your .env file to git!
# =============================================================================

# --- Security ---

# Web UI login PIN (CHANGE this; min 6 characters). install.sh randomizes it.
MARIA_PIN=change-me-123

# Session key (leave empty = auto-generated on start)
# For a stable key: python3 -c "import secrets; print(secrets.token_hex(32))"
MARIA_SECRET_KEY=

# --- Identity ---

# Name Maria calls you until onboarding sets one (used in greetings / prompts)
MARIA_OPERATOR_NAME=Operator

# --- Network ---

# Interface to listen on (0.0.0.0 = all LAN interfaces)
MARIA_HOST=0.0.0.0

# Web UI port
MARIA_PORT=5000

# CORS - defaults to the auto-detected LAN IP
# Example: MARIA_CORS_ORIGINS=http://192.168.1.100:5000
MARIA_CORS_ORIGINS=

# --- Ollama (local LLM) ---

# Ollama API URL (default: localhost)
OLLAMA_BASE_URL=http://localhost:11434

# --- NVIDIA NIM (optional cloud LLM for stronger analysis) ---

# NVIDIA NIM API key (6-month free tier)
NVIDIA_NIM_API_KEY=

# NIM endpoint URL (default: NVIDIA cloud)
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# NIM model (default: nemotron 70B)
NVIDIA_NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Token limits (daily / monthly)
NIM_DAILY_TOKEN_LIMIT=100000
NIM_MONTHLY_TOKEN_LIMIT=2000000

# Use NIM as the Web UI chat backend (default: false = Ollama)
# Set true to route chat through the stronger NIM model
NIM_CHAT_ENABLED=false

# --- Telegram bot (optional) ---

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Your Telegram chat ID (get it from @userinfobot)
TELEGRAM_CHAT_ID=

# --- Weather (OpenWeatherMap, optional) ---

# OpenWeatherMap API key (free tier: https://openweathermap.org/api)
OPENWEATHERMAP_API_KEY=
# City fallback if not set via /profile (format: "Berlin,DE")
OPENWEATHERMAP_CITY=

# --- Runtime ---

# Debug mode (keep false in production!)
MARIA_DEBUG=false

# Interactive chat: Ollama remains the default. Codex needs a separately
# installed CLI, login, network access, and a model available to your account.
MARIA_CHAT_BACKEND=ollama
CODEX_BIN=codex
MARIA_CODEX_MODEL=gpt-6.1-sol
MARIA_CHAT_RATE_LIMIT=2

# Optional local Polish speech recognition. Supply absolute paths to an
# executable whisper.cpp whisper-cli and a compatible nonempty model file.
MARIA_STT_BIN=
MARIA_STT_MODEL=
# Exact HTTPS origins, comma-separated, matching the URL opened on the phone.
MARIA_STT_ORIGINS=

# Optional external Kritaqo connectors. Disabled until configured.
MARIA_KRITAQO_CONTEXT=0
MARIA_KRITAQO_BRIDGE_PATH=
MARIA_KRITAQO_DATA_DIR=
# Absolute path to an operator-owned private JSON file; see VOICE_AND_PROJECTS.
MARIA_KRITAQO_TOOLS_CONFIG=

# Runtime policy: lean shortens optional model residency; background reasoning
# is a separate switch. Set it to 0 for an operator-first assistant.
MARIA_RUNTIME_PROFILE=standard
MARIA_BACKGROUND_REASONING=1
MARIA_TELEGRAM_INTEGRATION=1

# Optional camera. Install requirements-vision.txt for capture/motion and
# requirements-vision-objects.txt plus your ONNX model for object detection.
VISION_OBJECT_DETECTOR=
VISION_YOLO_MODEL=models/vision/yolo26n.onnx
VISION_YOLO_THREADS=2
VISION_CHANGE_BACKEND=opencv
# observe records comparisons; on suppresses repeated-frame descriptions.
VISION_CHANGE_GATE=observe
VISION_CHANGE_PIXEL_DELTA=0.15
VISION_CHANGE_MIN_AREA=0.02
